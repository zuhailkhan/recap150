[
  {"name":"below the level is dropped","input":[["Logger","log","log","lines"],[["INFO",[["memory","short"]]],["DEBUG","x",1],["INFO","hello",2],["memory"]]],"expected":[null,0,1,["INFO: hello"]]},
  {"name":"a record at exactly the level passes","input":[["Logger","log","log","log","lines"],[["WARN",[["memory","short"]]],["WARN","a",1],["ERROR","b",2],["INFO","c",3],["memory"]]],"expected":[null,1,1,0,["WARN: a","ERROR: b"]]},
  {"name":"every level passes at DEBUG","input":[["Logger","log","log","log","log","lines"],[["DEBUG",[["memory","short"]]],["DEBUG","a",1],["INFO","b",2],["WARN","c",3],["ERROR","d",4],["memory"]]],"expected":[null,1,1,1,1,["DEBUG: a","INFO: b","WARN: c","ERROR: d"]]},
  {"name":"each appender formats in its own way","input":[["Logger","log","lines","lines"],[["INFO",[["console","full"],["memory","short"]]],["INFO","start",5],["console"],["memory"]]],"expected":[null,2,["[5] INFO start"],["INFO: start"]]},
  {"name":"a failing appender does not break the others","input":[["Logger","log","failures","lines","lines"],[["INFO",[["broken","short"],["memory","short"],["console","full"]]],["ERROR","boom",7],[],["memory"],["console"]]],"expected":[null,2,["broken"],["ERROR: boom"],["[7] ERROR boom"]],"edge":true},
  {"name":"failures pile up while the rest keep working","input":[["Logger","log","log","failures","lines"],[["INFO",[["broken","short"],["memory","short"]]],["INFO","a",1],["WARN","b",2],[],["memory"]]],"expected":[null,1,1,["broken","broken"],["INFO: a","WARN: b"]]},
  {"name":"every appender failing writes nothing","input":[["Logger","log","failures"],[["INFO",[["broken","short"],["broken","full"]]],["INFO","a",1],[]]],"expected":[null,0,["broken","broken"]],"edge":true},
  {"name":"no appenders means nobody takes it","input":[["Logger","log"],[["ERROR",[]],["ERROR","a",1]]],"expected":[null,0],"edge":true},
  {"name":"changing the level at runtime","input":[["Logger","log","setLevel","log","setLevel","log","lines"],[["INFO",[["memory","short"]]],["DEBUG","a",1],["DEBUG"],["DEBUG","d",2],["ERROR"],["WARN","w",3],["memory"]]],"expected":[null,0,"INFO",1,"DEBUG",0,["DEBUG: d"]],"edge":true},
  {"name":"a filter drops a matching message","input":[["Logger","addFilter","log","log","lines"],[["INFO",[["memory","short"]]],["password"],["INFO","login ok",1],["INFO","password=123",2],["memory"]]],"expected":[null,1,1,0,["INFO: login ok"]]},
  {"name":"filters apply to every level that passed","input":[["Logger","addFilter","addFilter","log","log","log","lines"],[["DEBUG",[["memory","short"]]],["secret"],["token"],["WARN","token expired",1],["ERROR","a secret",2],["ERROR","fine",3],["memory"]]],"expected":[null,1,1,0,0,1,["ERROR: fine"]]},
  {"name":"the file starts a new file when full","input":[["Logger","log","log","log","log","log","files"],[["INFO",[["file","full",2]]],["INFO","a",1],["INFO","b",2],["INFO","c",3],["INFO","d",4],["INFO","e",5],[]]],"expected":[null,1,1,1,1,1,[["[1] INFO a","[2] INFO b"],["[3] INFO c","[4] INFO d"],["[5] INFO e"]]]},
  {"name":"time is read when the call is made","input":[["Logger","log","log","lines"],[["INFO",[["console","full"]]],["INFO","a",10],["INFO","b",20],["console"]]],"expected":[null,1,1,["[10] INFO a","[20] INFO b"]]}
]
