[
  {"name":"play, pause and resume","input":[["MusicPlayer","load","play","pause","state","play","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],[],[],[]]],"expected":[null,4,1,1,"Paused",1,"Playing"]},
  {"name":"next walks the queue and stops after the last song","input":[["MusicPlayer","load","play","next","next","next","next","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],[],[],[],[]]],"expected":[null,4,1,2,3,4,1,"Stopped"],"edge":true},
  {"name":"repeat all wraps forwards and backwards","input":[["MusicPlayer","load","repeat","play","next","next","next","next","prev"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],["all"],[],[],[],[],[],[]]],"expected":[null,4,null,1,2,3,4,1,4]},
  {"name":"repeat one replays a finished song but a skip moves on","input":[["MusicPlayer","load","repeat","play","ended","ended","next","ended"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],["one"],[],[],[],[],[]]],"expected":[null,4,null,1,1,1,2,2]},
  {"name":"repeat one still stops when you skip past the last song","input":[["MusicPlayer","load","repeat","play","next","next","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["mix"],["one"],[],[],[],[]]],"expected":[null,2,null,2,4,2,"Stopped"],"edge":true},
  {"name":"repeat off: the last song ending stops the player","input":[["MusicPlayer","load","play","ended","ended","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["mix"],[],[],[],[]]],"expected":[null,2,2,4,2,"Stopped"]},
  {"name":"a stopped player ignores everything but play","input":[["MusicPlayer","load","pause","stop","next","prev","ended","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],[],[],[],[]]],"expected":[null,4,-1,-1,-1,-1,-1,"Stopped"],"edge":true},
  {"name":"play while playing is ignored and stop rewinds","input":[["MusicPlayer","load","play","next","play","stop","state","play"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],[],[],[],[]]],"expected":[null,4,1,2,-1,1,"Stopped",1]},
  {"name":"next and previous while paused start playing","input":[["MusicPlayer","load","play","next","pause","prev","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],[],[],[]]],"expected":[null,4,1,2,2,1,"Playing"],"edge":true},
  {"name":"a paused song cannot end","input":[["MusicPlayer","load","play","pause","ended","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],[],[]]],"expected":[null,4,1,1,-1,"Paused"]},
  {"name":"previous on the first song stays on it","input":[["MusicPlayer","load","play","prev","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],[]]],"expected":[null,4,1,1,"Playing"]},
  {"name":"shuffle keeps the playing song first and reorders the rest","input":[["MusicPlayer","load","play","shuffle","queue","current"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[1],[],[]]],"expected":[null,4,1,null,[1,4,3,2],1]},
  {"name":"shuffle off returns to the added order on the same song","input":[["MusicPlayer","load","play","shuffle","next","next","shuffle","current","queue","next","next","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[1],[],[],[0],[],[],[],[],[]]],"expected":[null,4,1,null,4,3,null,3,[1,2,3,4],4,1,"Stopped"]},
  {"name":"a song enqueued on a shuffled queue goes last","input":[["MusicPlayer","load","play","shuffle","enqueue","queue","shuffle","queue"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[1],[2],[],[0],[]]],"expected":[null,4,1,null,5,[1,4,3,2,2],null,[1,2,3,4,2]]},
  {"name":"shuffling mid-way keeps the song that is playing","input":[["MusicPlayer","load","play","next","next","shuffle","queue","current","next"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],[],[1],[],[],[]]],"expected":[null,4,1,2,3,null,[3,4,2,1],3,4],"edge":true},
  {"name":"shuffle with repeat all visits every song once per lap","input":[["MusicPlayer","load","play","shuffle","repeat","next","next","next","next"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[1],["all"],[],[],[],[]]],"expected":[null,4,1,null,null,4,3,2,1]},
  {"name":"shuffling again uses the next numbers from the source","input":[["MusicPlayer","load","play","shuffle","queue","shuffle","shuffle","queue"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},42],["all"],[],[1],[],[0],[1],[]]],"expected":[null,4,1,null,[1,4,2,3],null,null,[1,3,2,4]]},
  {"name":"loading an unknown or empty playlist is refused","input":[["MusicPlayer","load","load","play","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["nope"],["empty"],[],[]]],"expected":[null,-1,-1,-1,"Stopped"],"edge":true},
  {"name":"loading a playlist replaces the queue and stops","input":[["MusicPlayer","load","play","next","load","state","current","queue"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["all"],[],[],["mix"],[],[],[]]],"expected":[null,4,1,2,2,"Stopped",2,[2,4]]},
  {"name":"enqueue refuses unknown songs and fills an empty queue","input":[["MusicPlayer","enqueue","enqueue","play"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],[9],[3],[]]],"expected":[null,-1,1,3]},
  {"name":"repeat all with a single song keeps playing it","input":[["MusicPlayer","load","repeat","play","next","ended","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],["solo"],["all"],[],[],[],[]]],"expected":[null,1,null,3,3,3,"Playing"],"edge":true},
  {"name":"the same song can be queued twice","input":[["MusicPlayer","enqueue","enqueue","play","next","next","state"],[[["A","B","C","D"],{"all":[1,2,3,4],"mix":[2,4],"solo":[3],"empty":[]},1],[1],[1],[],[],[],[]]],"expected":[null,1,2,1,1,1,"Stopped"]}
