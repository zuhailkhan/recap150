[
  {"name":"biggest notes first","input":[["ATM","insertCard","enterPin","withdraw","checkBalance"],[[[["A1","1234",1000],["B2","4321",100]],[[100,5],[50,5],[20,5],[10,5]],3,500],["A1"],["1234"],[270],[]]],"expected":[null,true,"ok","100x2 50x1 20x1",730]},
  {"name":"wrong pin then the right one","input":[["ATM","insertCard","enterPin","enterPin","checkBalance"],[[[["A1","1234",1000]],[[100,5],[50,5],[20,5],[10,5]],3,500],["A1"],["0000"],["1234"],[]]],"expected":[null,true,"wrong","ok",1000]},
  {"name":"third wrong pin locks the card and keeps it","input":[["ATM","insertCard","enterPin","enterPin","enterPin","checkBalance","insertCard"],[[[["A1","1234",1000]],[[100,5]],3,500],["A1"],["1"],["2"],["3"],[],["A1"]]],"expected":[null,true,"wrong","wrong","locked",-1,false],"edge":true},
  {"name":"a good pin resets the failure count","input":[["ATM","insertCard","enterPin","enterPin","enterPin","eject","insertCard","enterPin","enterPin"],[[[["A1","1234",1000]],[[100,5]],3,500],["A1"],["9"],["9"],["1234"],[],["A1"],["9"],["9"]]],"expected":[null,true,"wrong","wrong","ok",true,true,"wrong","wrong"],"edge":true},
  {"name":"a locked card does not lock the others","input":[["ATM","insertCard","enterPin","enterPin","enterPin","insertCard","enterPin","checkBalance"],[[[["A1","1234",1000],["B2","4321",100]],[[100,5]],3,500],["A1"],["1"],["2"],["3"],["B2"],["4321"],[]]],"expected":[null,true,"wrong","wrong","locked",true,"ok",100]},
  {"name":"limit counts across withdrawals","input":[["ATM","insertCard","enterPin","withdraw","withdraw","withdraw","withdraw","checkBalance"],[[[["A1","1234",1000]],[[100,5],[50,5],[20,5],[10,5]],3,500],["A1"],["1234"],[300],[300],[200],[10],[]]],"expected":[null,true,"ok","100x3","refused:limit","100x2","refused:limit",500],"edge":true},
  {"name":"more than the balance is refused","input":[["ATM","insertCard","enterPin","withdraw","withdraw","checkBalance"],[[[["B2","4321",100]],[[100,5],[50,5],[20,5],[10,5]],3,500],["B2"],["4321"],[150],[100],[]]],"expected":[null,true,"ok","refused:funds","100x1",0]},
  {"name":"an amount the notes cannot make","input":[["ATM","insertCard","enterPin","withdraw","withdraw","checkBalance"],[[[["A1","1234",1000]],[[100,5],[50,5],[20,5],[10,5]],3,500],["A1"],["1234"],[15],[0],[]]],"expected":[null,true,"ok","refused:cash","refused:amount",1000],"edge":true},
  {"name":"greedy gives up where a cleverer search would not","input":[["ATM","insertCard","enterPin","withdraw","withdraw","withdraw","checkBalance"],[[[["A1","1234",1000]],[[50,1],[20,3],[10,0]],3,500],["A1"],["1234"],[60],[50],[40],[]]],"expected":[null,true,"ok","refused:cash","50x1","20x2",910],"edge":true},
  {"name":"a short note falls through to smaller ones","input":[["ATM","insertCard","enterPin","withdraw","checkBalance"],[[[["A1","1234",1000]],[[100,1],[50,5],[20,5],[10,5]],3,500],["A1"],["1234"],[250],[]]],"expected":[null,true,"ok","100x1 50x3",750]},
  {"name":"operations out of order are refused","input":[["ATM","withdraw","checkBalance","enterPin","eject","insertCard","withdraw","checkBalance","enterPin","insertCard"],[[[["A1","1234",1000]],[[100,5]],3,500],[100],[],["1234"],[],["A1"],[100],[],["1234"],["A1"]]],"expected":[null,"refused:state",-1,"refused",false,true,"refused:state",-1,"ok",false],"edge":true},
  {"name":"an unknown card is not taken in","input":[["ATM","insertCard","enterPin"],[[[["A1","1234",1000]],[[100,5]],3,500],["Z9"],["1234"]]],"expected":[null,false,"refused"]},
  {"name":"eject ends the session","input":[["ATM","insertCard","enterPin","withdraw","eject","insertCard","checkBalance","enterPin","checkBalance"],[[[["A1","1234",1000],["B2","4321",100]],[[100,5]],3,500],["A1"],["1234"],[100],[],["B2"],[],["4321"],[]]],"expected":[null,true,"ok","100x1",true,true,-1,"ok",100]},
  {"name":"a second pin entry while signed in is refused","input":[["ATM","insertCard","enterPin","enterPin","checkBalance"],[[[["A1","1234",1000]],[[100,5]],3,500],["A1"],["1234"],["0000"],[]]],"expected":[null,true,"ok","refused",1000]},
  {"name":"the stock runs out","input":[["ATM","insertCard","enterPin","withdraw","withdraw","checkBalance"],[[[["A1","1234",1000]],[[20,2]],3,500],["A1"],["1234"],[40],[20],[]]],"expected":[null,true,"ok","20x2","refused:cash",960]}
