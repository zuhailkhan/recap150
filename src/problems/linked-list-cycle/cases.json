  {"name":"cycle back to index 1","input":[[3,2,0,-4],1],"expected":true},
  {"name":"cycle back to the head","input":[[1,2],0],"expected":true},
  {"name":"no cycle","input":[[1,2,3,4,5],-1],"expected":false},
  {"name":"empty list","input":[[],-1],"expected":false,"edge":true},
  {"name":"single node, no cycle","input":[[1],-1],"expected":false,"edge":true},
  {"name":"single node pointing at itself","input":[[1],0],"expected":true,"edge":true},
  {"name":"equal values, no cycle","input":[[1,1,1,1],-1],"expected":false,"edge":true},
  {"name":"equal values, cycle at the tail","input":[[1,1,1,1],3],"expected":true},
  {"name":"even length, cycle at the middle","input":[[1,2,3,4,5,6],2],"expected":true},
  {"name":"two nodes, no cycle","input":[[1,2],-1],"expected":false}
