[
  {"name":"one zero in the middle","input":[[[1,1,1],[1,0,1],[1,1,1]]],"expected":[[1,0,1],[0,0,0],[1,0,1]]},
  {"name":"zeros in the first row","input":[[[0,1,2,0],[3,4,5,2],[1,3,1,5]]],"expected":[[0,0,0,0],[0,4,5,0],[0,3,1,0]],"edge":true},
  {"name":"zero only in the first column","input":[[[1,2,3],[0,5,6],[7,8,9]]],"expected":[[0,2,3],[0,0,0],[0,8,9]],"edge":true},
  {"name":"zero at the corner","input":[[[0,2,3],[4,5,6],[7,8,9]]],"expected":[[0,0,0],[0,5,6],[0,8,9]]},
  {"name":"single cell zero","input":[[[0]]],"expected":[[0]],"edge":true},
  {"name":"single row","input":[[[1,0,3]]],"expected":[[0,0,0]]},
  {"name":"single column","input":[[[1],[0],[3]]],"expected":[[0],[0],[0]]},
  {"name":"no zeros","input":[[[1,2],[3,4]]],"expected":[[1,2],[3,4]]},
  {"name":"first row and column both marked","input":[[[1,0,3],[0,5,6],[7,8,0]]],"expected":[[0,0,0],[0,0,0],[0,0,0]]},
  {"name":"negatives and a zero","input":[[[-1,2,3],[4,0,-6],[7,8,-9]]],"expected":[[-1,0,3],[0,0,0],[7,0,-9]]},
  {"name":"whole matrix zero","input":[[[0,0],[0,0]]],"expected":[[0,0],[0,0]]}
